   "author": "",
   "text": "〓變變る霜やはおそき川風にほのかに出づる白菊の花",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0054",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "獨惜暮秋",
   "author": "",
   "text": "正止ずずいいにせむとて行秋の我身一つに悲かる覧",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0055",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "冬十首初冬時雨",
   "author": "",
   "text": "た神無月哀は變るしるしにて秋より冬にふる時雨かな",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0056",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "霜埋落葉",
   "author": "",
   "text": "七誘ひこし風も己が儘ならで霜に朽ちぬる庭の紅葉は",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0057",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "屋上聞被",
   "author": "",
   "text": "〓版はれし時雨の後の眞木の屋に音も變らで降る般哉",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0058",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "古寺初雪",
   "author": "",
   "text": "た誘はるゝ雲の紛ひにかつ降て雪も初潮の山風ぞ吹く",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0059",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "庭雪厭人",
   "author": "",
   "text": "cmとはれつる身の習はしの有顏に跡脈はるゝ庭の白雪",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0060",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "海邊松雪",
   "author": "",
   "text": "降る雪は積りにけりな白波の音せでこゆる末の松山",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0061",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "水江寒蘆",
   "author": "",
   "text": "一難波潟入江の波は音立てヽ章の枯葉に風もたまらず",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0062",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "湖上千鳥",
   "author": "",
   "text": "音たえて志賀の浦波凍る夜は立も障らで千鳥鳴く也",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0063",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "寒夜水鳥",
   "author": "",
   "text": "池水水立立離れぬ蘆鴨の浮寢ばかりぞ凍らざりける",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0064",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "歲暮測水",
   "author": "",
   "text": "徒につもり重ねて行く年の日かずも知らぬ谷川の水",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0065",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "戀二十首初尋緣戀",
   "author": "",
   "text": "誘ひくる霞の隙の春風にまだ見ぬ花の行へをぞとふ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0066",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "聞聲忍戀",
   "author": "",
   "text": "好よそに聞く雲居の雁の一聲も憂名忘ていかゞ忍ばむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0067",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "忍親服戀",
   "author": "",
   "text": "〓無名ぞと云ても果ていかならむ親の護の背く身ならば",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0068",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "所不會戀",
   "author": "",
   "text": "ないかに猶つれなからまし神だにも受ぬ契は程と知せば",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0069",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "旅宿逢戀",
   "author": "",
   "text": "變らでもあだなる中ぞ知れける唯一夜なる草の枕に",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0070",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "兼厭ハ〓戀",
   "author": "",
   "text": "一憂きものと聞きし計の曉を別れぬさきの身に厭ふ哉",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0071",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "歸無書戀",
   "author": "",
   "text": "三立歸り問れぬ程もつらからず今夜憂身と人に知られて",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0072",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "遇不會悉",
   "author": "",
   "text": "一面面さは變の中のつらさにて見しを忘る心ともがな",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0073",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "契經年戀",
   "author": "",
   "text": "四契しを賴む計に長らへて消ぬべき身の年ぞへにける",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0074",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "疑其僞感",
   "author": "",
   "text": "〓りりくんの心の僞は恨み果てぬるつらさなりけり",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0075",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "返事增戀",
   "author": "",
   "text": "畑恨みつる我が理も忘られて增るつらさに書ける玉章",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0076",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "被厭賊戀",
   "author": "",
   "text": "【愛き乍ら數ならぬ身のつらさにも厭れて社思知ぬれ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0077",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "途中契戀",
   "author": "",
   "text": "Noあだなりや道の芝草假そめに結びすてぬる露の契を",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0078",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "從門歸戀",
   "author": "",
   "text": "加深き夜の別と云て槇の戶の明ぬに歸る身とは知られじ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0079",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "忘住所戀",
   "author": "",
   "text": "11忘るとて人のかこたば等閑に〓へし宿と我も恨みむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0080",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "依戀所身",
   "author": "",
   "text": "エ神だにも憂身の程を知られずば逢に替むと猶や祈らむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0081",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "隔遠路戀",
   "author": "",
   "text": "五厭ふぞよ通ふ心のたのみだになくて隔つる峰の白雲",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0082",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "借人名戀",
   "author": "",
   "text": "三いいにせむ憂名を添て喞つ共つらき心の人を分かずば",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0083",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "絕不知戀",
   "author": "",
   "text": "同世に行方をさへに辿るこそ餘りよそなる契也けれ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0084",
   "pid": "873675",
   "pages": [
    84
   ],
   "no": null,
   "kotobagaki": "互恨絶戀",
   "author": "",
   "text": "五つらかりし心比べのたゝうきに思定めて遠かるらむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0085",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "雜二十首曉更寢覺",
   "author": "",
   "text": "〓〓の鳥の鳴の鳴く音を知べにて寢覺の程は身に習ひぬる",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0086",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "薄幕松風",
   "author": "",
   "text": "な吹く風も同じ綠の松がえに夕はなにと寂しかるらむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0087",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "雨中綠竹",
   "author": "",
   "text": "AL我我君君惠惠をそへて降る雨に御垣の竹の色ぞ殊なる",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0088",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "浪洗石苔",
   "author": "",
   "text": "な蒸蒸苦苦變變らで打寄する岩間の波の音ぞ碎くる",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0089",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "高山待月",
   "author": "",
   "text": "〓待ち出るほどぞ寂しき葛城や高間の山の秋の夜の月",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0090",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "山中瀧水",
   "author": "",
   "text": "〓瀧の音もまだ消別れぬ山水に習はですむは心也けり",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0091",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "河水流〓",
   "author": "",
   "text": "チ千ををてて一度すめる川水の流は君ぞ酌べかりける",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0092",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "春秋野遊",
   "author": "",
   "text": "2立立返り同野原にあくがれて花と紅葉も身にぞ馴ぬる",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0093",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "關路行客",
   "author": "",
   "text": "旅人の絕えぬ住來に逢坂の關守いかに苦しかるらむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0094",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "山家夕嵐",
   "author": "",
   "text": "山里にたへて住まむと思ひしは嵐も聞かぬ夕也けり",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0095",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "山家人稀",
   "author": "",
   "text": "思ひやれ變る人めの冬にだに限らぬ山の奥の寂しさ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0096",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "海路眺望",
   "author": "",
   "text": "見渡せば波間の日影暮ぬらしはや漕歸れ海士の釣舟",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0097",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "月縣中友",
   "author": "",
   "text": "ス契契らずよ別れし都のよはの月草の枕の友となれとは",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0098",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "旅宿夜雨",
   "author": "",
   "text": "林郡思ふ假寝の袖に降る雨やほさぬ淚の類ひなるらむ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0099",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "海邊曉雲",
   "author": "",
   "text": "〇七福てこし夜の間の雲や分るらむ顕れそむる沖つ白波",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0100",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "寄夢無常",
   "author": "",
   "text": "一あだに見し一夜の夢の其儘に覺ても元の浮世也けり",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0101",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "寄草述懷",
   "author": "",
   "text": "一理もるゝ霜の下草あらはれて榮えむ春の光をぞ待つ",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0102",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "寄木述懷",
   "author": "",
   "text": "ささりともと頼みをかけて春日山憂身忘るゝ北の藤波",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0103",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "逐日懐舊",
   "author": "",
   "text": "忍ばるゝその古は隔たりて待たぬ月日のなど積る覽",
   "sachu": "",
   "jo": ""
  },
  {
   "id": "zkt-fujikawa-gohyakushu-0104",
   "pid": "873675",
   "pages": [
    85
   ],
   "no": null,
   "kotobagaki": "社頭祝言",
   "author": "",
   "text": "エ萬萬にまつの千年の色そへて君をぞまもる住吉の神",
   "sachu": "",
   "jo": ""
  }
 ]
}
